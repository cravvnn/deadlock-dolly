[
  {
    "name": "start shot before old lease retired",
    "replace": [
      [
        "StartShot == /\\ app = \"running\" /\\ ~lease /\\ gen < 2",
        "StartShot == /\\ app = \"running\" /\\ gen < 2"
      ]
    ],
    "expect": "NewWriterAfterRetirement"
  },
  {
    "name": "close keeps heartbeat running",
    "replace": [
      [
        "app' = \"closed\" /\\ link' = FALSE",
        "app' = \"closed\" /\\ link' = link"
      ]
    ],
    "expect": "CloseReleases"
  },
  {
    "name": "no heartbeat-expiry release",
    "replace": [
      [
        "Expire == /\\ ~link /\\ game /\\ writer = \"shot\"",
        "Expire == /\\ FALSE /\\ ~link /\\ game /\\ writer = \"shot\""
      ]
    ],
    "expect": "CloseReleases"
  },
  {
    "name": "no media detach stop after close",
    "replace": [
      [
        "RecFinish == /\\ rec = \"on\" /\\ game /\\",
        "RecFinish == /\\ rec = \"on\" /\\ game /\\ app # \"closed\" /\\"
      ]
    ],
    "expect": "RecordingSettles"
  },
  {
    "name": "no restoration retry",
    "replace": [
      [
        "Restore == /\\ Camera!Restore /\\",
        "Restore == /\\ FALSE /\\ Camera!Restore /\\"
      ]
    ],
    "expect": "CloseReleases"
  },
  {
    "name": "publish Release before the playback worker joined",
    "replace": [
      [
        "/\\ writer = \"shot\"\n                   /\\ ~worker",
        "/\\ writer = \"shot\""
      ]
    ],
    "expect": "QuietWhenRetired"
  },
  {
    "name": "recover a dead session without joining the worker",
    "replace": [
      [
        "RecoverDead == /\\ app \\in {\"running\", \"closing\"} /\\ ~worker /\\ Camera!Lost",
        "RecoverDead == /\\ app \\in {\"running\", \"closing\"} /\\ Camera!Lost"
      ]
    ],
    "expect": "QuietWhenRetired"
  },
  {
    "name": "restore capture context before terminal readback",
    "replace": [
      [
        "/\\ ctx = \"held\" /\\ game /\\ outcome \\in Recorder!Terminal /\\ ctxReady",
        "/\\ ctx = \"held\" /\\ game /\\ ctxReady"
      ]
    ],
    "expect": "CaptureAfterOutcome"
  },
  {
    "name": "unmap without asking the encoder to stop",
    "replace": [
      [
        "/\\ link' = FALSE /\\ Media!Unmap",
        "/\\ link' = FALSE /\\ unmapped' = TRUE /\\ UNCHANGED stopAsked"
      ]
    ],
    "expect": "StopBeforeUnmap"
  },
  {
    "name": "only Dolly's window cleans up the game files",
    "replace": [
      [
        "GiCleanRestore == /\\ ~game /\\ Gameinfo!Restore",
        "GiCleanRestore == /\\ ~game /\\ app = \"running\" /\\ Gameinfo!Restore"
      ]
    ],
    "expect": "GameFilesSettle"
  },
  {
    "name": "the plugin folder is never removed after exit",
    "replace": [
      [
        "/\\ WF_vars(GiCleanRestore) /\\ WF_vars(GiRemove)",
        "/\\ WF_vars(GiCleanRestore)"
      ]
    ],
    "expect": "GameFilesSettle"
  }
]
