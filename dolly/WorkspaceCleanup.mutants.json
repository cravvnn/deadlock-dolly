[
  {
    "name": "cleanup omits shared installation lock",
    "replace": [
      [
        "UsesLock == Design = \"locked\"",
        "UsesLock == FALSE"
      ]
    ],
    "expect": "UnfinishedJournalKept"
  },
  {
    "name": "cleanup ignores pending recovery marker",
    "replace": [
      [
        "IF marker THEN CleanerFinish",
        "IF FALSE THEN CleanerFinish"
      ]
    ],
    "expect": "NoRecoveryLoss"
  },
  {
    "name": "cleanup discards an unfinished journal",
    "replace": [
      [
        "journal \\notin {\"none\",\"complete\"} \\/ ~workspace",
        "FALSE \\/ ~workspace"
      ]
    ],
    "expect": "UnfinishedJournalKept"
  }
]
