[
  {
    "name": "cleanup omits shared installation lock",
    "replace": [
      [
        "UsesLock == Design = \"locked\"",
        "UsesLock == FALSE"
      ]
    ],
    "expect": "NoEditorDuringAdmittedUpdate"
  },
  {
    "name": "cleanup ignores pending recovery marker",
    "replace": [
      [
        "IF marker THEN CleanerFinish",
        "IF FALSE THEN CleanerFinish"
      ]
    ],
    "expect": "NoRecoveryLoss"
  },
  {
    "name": "cleanup discards an unfinished journal",
    "replace": [
      [
        "journal = \"applying\" \\/ ~workspace",
        "FALSE \\/ ~workspace"
      ]
    ],
    "expect": "UnfinishedJournalKept"
  },
  {
    "name": "drop an unusable record without checking the install",
    "replace": [
      [
        "IF marker /\\ ~readable /\\ Consistent THEN ClearUnusable",
        "IF marker /\\ ~readable THEN ClearUnusable"
      ]
    ],
    "expect": "HalfInstalledKeepsRecord"
  },
  {
    "name": "an unusable record always blocks opening",
    "replace": [
      [
        "IF marker /\\ ~readable /\\ Consistent THEN ClearUnusable",
        "IF FALSE THEN ClearUnusable"
      ]
    ],
    "expect": "OpensOverIntactInstall"
  }
]
