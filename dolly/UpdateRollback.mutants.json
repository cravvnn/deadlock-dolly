[
  {
    "name": "acknowledge before all files restored",
    "replace": [
      [
        "pc = SavePc /\\ journal'",
        "pc \\in {2, SavePc} /\\ journal'"
      ]
    ],
    "expect": "NoPrematureAck"
  },
  {
    "name": "release pending marker before recovery",
    "replace": [
      [
        "pc = ReleasePc /\\ marker'",
        "pc \\in {1, ReleasePc} /\\ marker'"
      ]
    ],
    "expect": "RecoveryComplete"
  },
  {
    "name": "consume a supposedly immutable backup",
    "replace": [
      [
        "THEN /\\ Disk!Copy(Current)",
        "THEN /\\ Disk!Move(Current)"
      ]
    ],
    "expect": "ImmutableCopyBackups"
  },
  {
    "name": "rollback restores in name order",
    "config": "UpdateRollback-fileToDir.cfg",
    "replace": [
      [
        "RKey(f) == IF Original[f] = \"absent\" THEN 10 - f ELSE 20 + f",
        "RKey(f) == f"
      ]
    ],
    "expect": "NoRecoveryError"
  },
  {
    "name": "install writes before it removes",
    "config": "UpdateRollback-dirToFile.cfg",
    "replace": [
      [
        "Key(f) == IF Updated[f] = \"absent\" THEN 10 - f ELSE 20 + f",
        "Key(f) == f"
      ]
    ],
    "expect": "UpdateInstallable"
  },
  {
    "name": "remove a file without pruning the folder it empties",
    "config": "UpdateRollback-fileToDir.cfg",
    "replace": [
      [
        "Pruned(f) == folders\n",
        "Pruned(f) == folders \\cup {p \\in Files: Inside(f, p)}\n"
      ]
    ],
    "expect": "NoRecoveryError"
  }
]
